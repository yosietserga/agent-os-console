// ════════════════════════════════════════════════════════════════════════
// Agent OS — Esquema de Datos del Sistema de Control Agéntico
// Implementa: Memoria Empírica Append-Only (P9), PRE-v2.0, PSIM,
// L2 Control Plane, Mejorate Scans y Radiografía de Ingeniería Inversa
// ════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Constitución AGENTS.md ──────────────────────────────────────────────

model CardinalRule {
  id          String   @id @default(cuid())
  code        String   @unique // P1..P15, W-CTA
  title       String
  description String
  severity    String // RED | YELLOW
  category    String
  order       Int
}

model CommandDef {
  id          String @id @default(cuid())
  name        String @unique
  aliases     String // separados por coma
  action      String
  methodology String
  description String
  order       Int
}

// ── Memoria Empírica (Append-Only, Regla P9) ────────────────────────────

model MemoryEntry {
  id        String   @id @default(cuid())
  type      String // ANTI_PATTERN | WIN | WORKLOG | FEEDBACK | USER | PROJECT | REFERENCE
  code      String?  @unique // AP-001, WIN-001...
  title     String
  content   String
  winClass  String? // W1..W8 (solo WIN)
  severity  String? // CRITICA | ALTA | MEDIA
  epoch     Int
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

// ── Mejorate: Repos de Referencia y Scans ───────────────────────────────

model ReferenceRepo {
  id            String   @id @default(cuid())
  repo          String   @unique // owner/name
  category      String // extraccion-estructural | inspeccion-tecnica | replicacion-visual | agent-skills | modelo-negocio
  role          String // integración en el pipeline
  description   String
  stars         Int
  sizeKb        Int
  language      String?
  branch        String
  topics        String // JSON array
  topDirs       String // JSON array
  keyFiles      String // JSON array {path,size}
  ghDescription String?
  lastScannedAt DateTime @default(now())
}

model ScanRun {
  id           String    @id @default(cuid())
  mode         String // scan | synthesize
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  reposScanned Int
  totalStars   Int
  status       String // RUNNING | COMPLETED | FAILED
  note         String?
  patterns     ExtractedPattern[]
}

model ExtractedPattern {
  id         String   @id @default(cuid())
  scanRunId  String?
  scanRun    ScanRun? @relation(fields: [scanRunId], references: [id])
  repo       String
  category   String
  pattern    String
  evidence   String
  createdAt  DateTime @default(now())
}

// ── Gobernanza PRE-v2.0 (Ejecutor / Optimizador / Juez) ─────────────────

model AdoptionProposal {
  id          String    @id @default(cuid())
  title       String
  type        String // BP | AP | KILLER | SKILL | WIDGET | MCP
  origin      String // repo de origen
  description String
  status      String // PROPOSED | EVALUATED | PROMOTED | REJECTED
  d1          Float? // Compilación/Tipado (w=0.20)
  d2          Float? // Fidelidad de Contratos (w=0.15)
  d3          Float? // Adherencia al Pipeline (w=0.20)
  d4          Float? // Casos Ocultos (w=0.20)
  d5          Float? // Eficiencia de Tokens (w=0.10)
  d6          Float? // Arquitectura/Reglas Críticas (w=0.15)
  deltaS      Float?
  verdict     String?
  createdAt   DateTime  @default(now())
  evaluatedAt DateTime?
}

// ── PSIM: Estado de KPIs y Victorias ────────────────────────────────────

model PsimState {
  id        String   @id @default(cuid())
  version   String
  epoch     Int
  k1        Float // P0/P1 Closure Rate (>= 0.90)
  k2        Float // Mock Reduction Velocity (pendiente negativa)
  k3        Float // Finding Half-Life (<= 2 iteraciones)
  k4        Float // Capability-Strengthening Count (>= 1 por iteración)
  k5        Float // Gate Stability Streak (racha monótona)
  w1        Int
  w2        Int
  w3        Int
  w4        Int
  w5        Int
  w6        Int
  w7        Int
  w8        Int
  updatedAt DateTime @updatedAt
}

// ── L2 Control Plane ────────────────────────────────────────────────────

model L2Model {
  id          String  @id @default(cuid())
  name        String  @unique
  provider    String
  tier        String // REASONING_FRONTIER | GENERAL_PURPOSE | FAST_CHEAP | SLM_MICRO
  latencySlaMs Int
  role        String // PRIMARY | FALLBACK | ESCALATION | LOCAL_RULES
  archetype   String // Vision-to-Spec | Accounting-OCR | Commerce-Bot | Fraud-Guard | Console
  status      String  @default("CLOSED") // CLOSED | OPEN | HALF_OPEN
  failRate    Float   @default(0)
  samples     Int     @default(0)
}

model CostLedgerEntry {
  id               String   @id @default(cuid())
  model            String
  tenant           String
  purpose          String // mejorate-synthesize | radiografia | l2-infer
  promptTokens     Int
  completionTokens Int
  costUsd          Float
  latencyMs        Int
  outcome          String // OK | FALLBACK | ERROR
  createdAt        DateTime @default(now())
}

// ── Bitácora de Comandos (auditoría) ────────────────────────────────────

model CommandLog {
  id         String   @id @default(cuid())
  command    String
  args       String?
  output     String
  status     String // OK | ERROR
  durationMs Int
  createdAt  DateTime @default(now())
}

// ── Radiografía de Ingeniería Inversa (Pipeline Rayos X) ────────────────

model RadiografiaRun {
  id            String    @id @default(cuid())
  targetUrl     String // URL objetivo (single) o etiqueta de fuentes (multimodal)
  sourceType    String    @default("url") // url | multimodal
  sourcesJson   String? // JSON: metadata de fuentes multimodales (sin base64)
  conceptsJson  String? // JSON: conceptos, pantallas y motion design detectados
  targetTitle   String?
  status        String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  phase         Int       @default(0) // 0..5
  brandTokens   String? // JSON: paleta, tipografías, radius, layout
  domStructure  String? // JSON: jerarquía DOM y posiciones canónicas
  shaders3d     String? // JSON: WebGL/Three.js detectado
  businessModel String? // JSON: pricing, planes, valor
  contracts     String? // JSON: APIs/contratos detectados
  reconstruction String? // JSON: componentes y tokens normalizados
  verification  String? // JSON: veredicto AGREE/DISAGREE
  summary       String?
  tokensUsed    Int       @default(0)
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
}

// ── Reportes Époch (inmutables) ─────────────────────────────────────────

model Report {
  id        String   @id @default(cuid())
  epoch     Int
  title     String
  verdict   String // AGREE | DISAGREE | MIXED
  content   String
  createdAt DateTime @default(now())
}

// ── Ciclo Autónomo de Calidad (comando vigila, v1.9.0, AP-031) ──────────
// El sentinela detecta fallas sin procesar y abre por cada una un ciclo de
// 7 etapas: detectar → analizar → investigar → corregir → verificar →
// criterios posteriores → reportar. Append-only en evidencia (P9).

model Finding {
  id         String   @id @default(cuid())
  sourceRef  String   @unique // cmd:<logId> | radio:<runId> | l2:<model>:<purpose> | budget:<command>
  source     String // COMMAND_LOG | RADIOGRAFIA | L2_LEDGER | GATEWAY_BUDGET
  severity   String // CRITICAL | HIGH | MEDIUM | LOW
  title      String
  evidence   String // JSON: contexto crudo + análisis + investigación (append P9)
  status     String   @default("DETECTED") // DETECTED | ANALYZED | CORRECTED | VERIFIED | RESOLVED | NO_DEFECT | ESCALATED
  detectedAt DateTime @default(now())
}

model CycleRun {
  id          String    @id @default(cuid())
  trigger     String // AUTO_ON_ERROR | SENTINEL_SCAN | MANUAL
  status      String    @default("RUNNING") // RUNNING | COMPLETED | FAILED | ESCALATED
  findingId   String?   @unique
  stages      String    @default("[]") // JSON [{name, status, durationMs, evidence}]
  reportEpoch Int?
  summary     String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
}

// ── Bucle Agéntico Goal-Driven (comando bucle, v2.0.0) ───────────────────
// Orquestador del bucle infinito: goals definidos y generados desde el
// prompt inicial → investiga (cero conocimiento) → plan de pasos y tareas
// → reporte PRE → ejecución → reporte PRO → auto-crítica (P13) →
// auto-aprendizaje (P9) → evaluación de goals → handoff → siguiente
// iteración hasta lograr los goals. Artefactos vinculados al tema del
// prompt (binding: el tema proviene del prompt, no del LLM).

model WorkflowRun {
  id            String    @id @default(cuid())
  prompt        String // prompt inicial del operador (crudo, inmutable)
  topic         String // tema extraído del prompt — binding de artefactos
  status        String    @default("RUNNING") // RUNNING | COMPLETED | PAUSED | FAILED
  iteration     Int       @default(0)
  maxIterations Int       @default(3)
  currentStage  String? // etapa en curso de la iteración corriente
  stageDetail   String? // última línea de evidencia de la etapa
  stages        String    @default("[]") // JSON etapas de la iteración corriente [{name,status,durationMs,evidence}]
  handoff       String? // JSON: contexto entregado a la siguiente iteración
  goalsAchieved Int       @default(0)
  startedAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  finishedAt    DateTime?
  goals         Goal[]
  tasks         TaskStep[]
}

model Goal {
  id         String      @id @default(cuid())
  runId      String
  run        WorkflowRun @relation(fields: [runId], references: [id])
  code       String // G1, G2, ...
  title      String
  acceptance String // criterio de aceptación verificable
  status     String      @default("PENDING") // PENDING | IN_PROGRESS | ACHIEVED | BLOCKED
  evidence   String? // evidencia del logro (tarea/reporte que la produce)
  iteration  Int         @default(0) // última iteración que lo evaluó
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([runId, status])
}

model TaskStep {
  id        String      @id @default(cuid())
  runId     String
  run       WorkflowRun @relation(fields: [runId], references: [id])
  goalCode  String? // G1... (tarea al servicio de ese goal)
  iteration Int
  order     Int
  title     String
  kind      String // INVESTIGATE | ANALYZE | VERIFY | PROPOSE | REPORT | OUT_OF_SCOPE
  status    String      @default("PENDING") // PENDING | RUNNING | DONE | FAILED | SKIPPED | OUT_OF_SCOPE
  output    String? // evidencia/resultado crudo
  createdAt DateTime    @default(now())

  @@index([runId, iteration, order])
}

// ── Instanciador Zero-Shot (Protocolo 11): scaffold AGENTS.md adaptado ────
model BootstrapRun {
  id           String          @id @default(cuid())
  prompt       String // prompt crudo del operador (cero conocimiento asumido)
  radiografiaId String? // run de Radiografía multimodal vinculado (fase previa)
  projectName  String?
  slug         String?
  status       String          @default("PENDING") // PENDING | RESEARCHING | PLANNING | GENERATING | VERIFYING | PACKAGING | COMPLETED | ERROR
  progress     Int             @default(0) // 0-100
  phaseDetail  String?
  researchJson String? // hallazgos web_search (fase investigate)
  specJson     String? // spec estructurada (fase plan)
  fileCount    Int             @default(0)
  llmCalls     Int             @default(0)
  durationMs   Int?
  error        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  files        BootstrapFile[]

  @@index([createdAt])
}

model BootstrapFile {
  id        String       @id @default(cuid())
  runId     String
  run       BootstrapRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  path      String // ruta relativa dentro del scaffold (ej. AGENTS.md)
  content   String
  bytes     Int          @default(0)
  origin    String // llm | template | static
  phase     String?
  createdAt DateTime     @default(now())

  @@unique([runId, path])
  @@index([runId])
}
