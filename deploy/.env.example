# ── Agent OS Console — configuración de despliegue ──────────────────────
# Copiar a deploy/.env en el VPS (deploy/README.md, sección despliegue).

# URL pública bajo la que se publica la app:
#   - Un dominio tuyo con registro A → IP del VPS (ej: agentos.midominio.com)
#     → Caddy emite certificado TLS de Let's Encrypt automáticamente.
#   - ":80" → HTTP directo sobre la IP del VPS (sin dominio).
SITE_ADDR=:80

# Token de acceso personal de GitHub (read-only basta).
# Da cuota 5.000 req/h al comando `mejorate` (scan de los 19 repos de
# referencia). Sin token: cuota anónima 60/h por IP compartida.
GITHUB_TOKEN=
