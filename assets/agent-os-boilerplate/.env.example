# ─────────────────────────────────────────────────────────────
# Agent OS Boilerplate — .env.example
# Copia a .env y rellena con tus valores reales.
# NUNCA commitear .env (ver .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Aplicación ──
APP_NAME=agent-os
APP_ENV=development            # development | staging | production
APP_PORT=3000
APP_URL=http://localhost:3000

# ── Entornos Dev/Deploy (Regla P10) ──
DEV_OS=windows                # windows | macos | linux (donde se desarrolla)
DEPLOY_OS=ubuntu              # ubuntu | debian | alpine | windows-server (donde se despliega)
# Los scripts *.sh asumen bash en DEPLOY_OS; en Windows-dev requieren WSL o Git Bash.

# ── Base de datos (Control Plane L2) ──
DATABASE_URL=postgresql://user:password@localhost:5432/agent_os
DATABASE_SSL=false

# ── Cache / Pub-Sub ──
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=agent-os

# ── Mensajería (opcional, para Transactional Outbox) ──
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_VHOST=/

# ── Proveedores LLM (Control Plane L2 — deja vacíos los que no uses) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=

# ── LLM local (vLLM / Ollama / LM Studio) ──
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000

# ── Telemetría / Observabilidad ──
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agent-os
SENTRY_DSN=

# ── Autenticación ──
JWT_SECRET=change-me-to-a-32-byte-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL=900            # 15 min
JWT_REFRESH_TTL=604800        # 7 días
MASTER_ENCRYPTION_KEY=       # AES-256-GCM, 32 bytes en base64

# ── Presupuestos L2 (cortes automáticos por tenant) ──
DEFAULT_MONTHLY_BUDGET_USD=100.00
CIRCUIT_BREAKER_FAIL_THRESHOLD=0.40
CIRCUIT_BREAKER_MIN_SAMPLES=10
CIRCUIT_BREAKER_RESET_MS=30000
BACKOFF_BASE_MS=200
BACKOFF_MAX_MS=3000

# ── Gobernanza PRE-v2.0 ──
PRE_PROMOTION_EPSILON=5.0
PRE_REGRESSION_DELTA=2.0
PRE_HIDDEN_BENCHMARK_RATIO=0.30
